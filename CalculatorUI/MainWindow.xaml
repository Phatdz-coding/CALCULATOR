<Window x:Class="CalculatorUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scientific Calculator"
        Width="676"
        Height="988"
        MinWidth="520"
        MinHeight="760"
        Background="#202124"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewTextInput="Window_PreviewTextInput">
    <Window.Resources>
        <Style x:Key="CalcButton" TargetType="Button">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinHeight" Value="52"/>
            <Setter Property="Background" Value="#303134"/>
            <Setter Property="Foreground" Value="#F1F3F4"/>
            <Setter Property="BorderBrush" Value="#3C4043"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="FunctionButton" TargetType="Button" BasedOn="{StaticResource CalcButton}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="#2B3036"/>
        </Style>

        <Style x:Key="OperatorButton" TargetType="Button" BasedOn="{StaticResource CalcButton}">
            <Setter Property="Background" Value="#3A4756"/>
        </Style>

        <Style x:Key="EqualsButton" TargetType="Button" BasedOn="{StaticResource CalcButton}">
            <Setter Property="Background" Value="#8AB4F8"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ModeToggleButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,0,10,8"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Background" Value="#202124"/>
            <Setter Property="Foreground" Value="#F1F3F4"/>
            <Setter Property="BorderBrush" Value="#3C4043"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ModeFlyoutButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#202124"/>
            <Setter Property="Foreground" Value="#F1F3F4"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="CalculatorComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="#171717"/>
            <Setter Property="Foreground" Value="#F1F3F4"/>
            <Setter Property="BorderBrush" Value="#3C4043"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="ItemContainerStyle" Value="{DynamicResource CalculatorComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2"/>
                            <DockPanel LastChildFill="True">
                                <ToggleButton x:Name="DropDownToggle"
                                              DockPanel.Dock="Right"
                                              Width="32"
                                              Focusable="False"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press"
                                              Background="{TemplateBinding Background}"
                                              BorderThickness="0">
                                    <TextBlock Text="v"
                                               Foreground="{TemplateBinding Foreground}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="12"/>
                                </ToggleButton>
                                <ContentPresenter Margin="10,2,4,2"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  RecognizesAccessKey="True"/>
                            </DockPanel>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="#202124"
                                        BorderBrush="#3C4043"
                                        BorderThickness="1">
                                    <ScrollViewer Margin="0"
                                                  SnapsToDevicePixels="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CalculatorComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#202124"/>
            <Setter Property="Foreground" Value="#F1F3F4"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#3A4756"/>
                    <Setter Property="Foreground" Value="#F1F3F4"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3A4756"/>
                    <Setter Property="Foreground" Value="#F1F3F4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <ToggleButton x:Name="ModeToggleButton"
                              Content="&#x2630;"
                              Style="{StaticResource ModeToggleButton}"
                              ToolTip="Calculator modes"/>
                <TextBlock x:Name="ModeTitleTextBlock"
                           Text="Scientific"
                           Foreground="#F1F3F4"
                           FontSize="22"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,0,8"/>
            </StackPanel>

            <Popup IsOpen="{Binding IsChecked, ElementName=ModeToggleButton}"
                   PlacementTarget="{Binding ElementName=ModeToggleButton}"
                   Placement="Bottom"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   PopupAnimation="Fade">
                <Border Width="292"
                        MaxHeight="430"
                        Background="#202124"
                        BorderBrush="#3C4043"
                        BorderThickness="1"
                        Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- <Button Content="Standard" Tag="Standard" Style="{StaticResource ModeFlyoutButton}" Click="Mode_Click"/> -->
                            <Button Content="Scientific" Tag="Scientific" Style="{StaticResource ModeFlyoutButton}" Click="Mode_Click"/>
                            <Rectangle Height="1" Fill="#3C4043" Margin="8,8"/>
                            <Button Content="Derivative Calculator" Tag="Derivative Calculator" Style="{StaticResource ModeFlyoutButton}" Click="Mode_Click"/>
                            <Button Content="Integral Calculator" Tag="Integral Calculator" Style="{StaticResource ModeFlyoutButton}" Click="Mode_Click"/>
                            <Rectangle Height="1" Fill="#3C4043" Margin="8,8"/>
                            <Button Content="Solve Quadratic Equation" Tag="Solve Quadratic Equation" Style="{StaticResource ModeFlyoutButton}" Click="Mode_Click"/>
                            <Button Content="Solve Cubic Equation" Tag="Solve Cubic Equation" Style="{StaticResource ModeFlyoutButton}" Click="Mode_Click"/>
                            <Button Content="Solve Quartic Equation" Tag="Solve Quartic Equation" Style="{StaticResource ModeFlyoutButton}" Click="Mode_Click"/>
                            <Button Content="Solve n-degree Polynomial Equation" Tag="Solve n-degree Polynomial Equation" Style="{StaticResource ModeFlyoutButton}" Click="Mode_Click"/>
                            <Rectangle Height="1" Fill="#3C4043" Margin="8,8"/>
                            <Button Content="Solve System of Linear Equations" Tag="Solve System of Linear Equations" Style="{StaticResource ModeFlyoutButton}" Click="Mode_Click"/>
                            <Button Content="Solve System of Non-linear Equations" Tag="Solve System of Non-linear Equations" Style="{StaticResource ModeFlyoutButton}" Click="Mode_Click"/>
                            <Button Content="Solve Any Equation" Tag="Solve Any Equation" Style="{StaticResource ModeFlyoutButton}" Click="Mode_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Popup>
        </Grid>

        <TextBox x:Name="DisplayTextBox"
                 Grid.Row="1"
                 Text="0"
                 FontSize="34"
                 FontWeight="SemiBold"
                 TextAlignment="Right"
                 VerticalContentAlignment="Bottom"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 IsReadOnly="True"
                 Background="#171717"
                 Foreground="#FFFFFF"
                 BorderBrush="#3C4043"
                 Padding="14"/>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <UniformGrid x:Name="KeypadGrid" Columns="5" Rows="7">
                <Button Content="C" Style="{StaticResource FunctionButton}" Click="Clear_Click"/>
                <Button Content="Back" Style="{StaticResource FunctionButton}" Click="Backspace_Click"/>
                <Button Content="(" Style="{StaticResource FunctionButton}" Click="Input_Click"/>
                <Button Content=")" Style="{StaticResource FunctionButton}" Click="Input_Click"/>
                <Button Content="&#x00F7;" Tag="/" ToolTip="/" Style="{StaticResource OperatorButton}" Click="Input_Click"/>

                <Button Content="sin(" Style="{StaticResource FunctionButton}" Click="Input_Click"/>
                <Button Content="cos(" Style="{StaticResource FunctionButton}" Click="Input_Click"/>
                <Button Content="tan(" Style="{StaticResource FunctionButton}" Click="Input_Click"/>
                <Button Content="x&#x02B8;" Tag="^" ToolTip="^" Style="{StaticResource OperatorButton}" Click="Input_Click"/>
                <Button Content="&#x00D7;" Tag="*" ToolTip="*" Style="{StaticResource OperatorButton}" Click="Input_Click"/>

                <Button Content="ln(" Style="{StaticResource FunctionButton}" Click="Input_Click"/>
                <Button Content="&#x221A;" Tag="sqrt(" ToolTip="sqrt(" Style="{StaticResource FunctionButton}" Click="Input_Click"/>
                <Button Content="&#x03C0;" Tag="pi" ToolTip="pi" Style="{StaticResource FunctionButton}" Click="Input_Click"/>
                <Button Content="e" Style="{StaticResource FunctionButton}" Click="Input_Click"/>
                <Button Content="&#x2212;" Tag="-" ToolTip="-" Style="{StaticResource OperatorButton}" Click="Input_Click"/>

                <Button Content="7" Style="{StaticResource CalcButton}" Click="Input_Click"/>
                <Button Content="8" Style="{StaticResource CalcButton}" Click="Input_Click"/>
                <Button Content="9" Style="{StaticResource CalcButton}" Click="Input_Click"/>
                <Button Content="|x|" Tag="abs(" ToolTip="abs(" Style="{StaticResource FunctionButton}" Click="Input_Click"/>
                <Button Content="+" Style="{StaticResource OperatorButton}" Click="Input_Click"/>

                <Button Content="4" Style="{StaticResource CalcButton}" Click="Input_Click"/>
                <Button Content="5" Style="{StaticResource CalcButton}" Click="Input_Click"/>
                <Button Content="6" Style="{StaticResource CalcButton}" Click="Input_Click"/>
                <Button Content="lg(" ToolTip="log10" Style="{StaticResource FunctionButton}" Click="Input_Click"/>
                <Button Content="Enter" Style="{StaticResource EqualsButton}" Click="Equals_Click"/>

                <Button Content="1" Style="{StaticResource CalcButton}" Click="Input_Click"/>
                <Button Content="2" Style="{StaticResource CalcButton}" Click="Input_Click"/>
                <Button Content="3" Style="{StaticResource CalcButton}" Click="Input_Click"/>
                <Button Content="x" Style="{StaticResource FunctionButton}" Click="Input_Click"/>
                <Button Content="," Style="{StaticResource FunctionButton}" Click="Input_Click"/>

                <Button Content="0" Style="{StaticResource CalcButton}" Click="Input_Click"/>
                <Button Content="." Style="{StaticResource CalcButton}" Click="Input_Click"/>
                <Button Content="!" Style="{StaticResource FunctionButton}" Click="Input_Click"/>
                <Button Content="=" Style="{StaticResource OperatorButton}" Click="Input_Click"/>
                <Button Content="State" Style="{StaticResource FunctionButton}" Click="ClearState_Click"/>
            </UniformGrid>

            <StackPanel x:Name="DerivativePanel" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="10,8">
                <TextBlock Text="Derivative mode" Foreground="#F1F3F4" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <TextBlock Text="Function" Foreground="#9AA0A6" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="DerivativeFunctionTextBox" Height="52" FontSize="18" Background="#171717" Foreground="#FFFFFF" BorderBrush="#3C4043" Padding="12" Margin="0,0,0,12"/>
                <TextBlock Text="Variable (single letter)" Foreground="#9AA0A6" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="DerivativeVariableTextBox" Height="52" FontSize="18" Background="#171717" Foreground="#FFFFFF" BorderBrush="#3C4043" Padding="12" MaxLength="1" Width="140" Margin="0,0,0,14"/>
                <Button Content="Differentiate" Style="{StaticResource EqualsButton}" Width="140" HorizontalAlignment="Left" Click="ApplyDerivative_Click"/>
                <!-- <TextBlock Text="Builds dif(function, variable)" Foreground="#9AA0A6" FontSize="12" Margin="0,12,0,0"/> -->
            </StackPanel>

            <StackPanel x:Name="IntegralPanel" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="10,8">
                <TextBlock Text="Integral mode" Foreground="#F1F3F4" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <TextBlock Text="Function" Foreground="#9AA0A6" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="IntegralFunctionTextBox" Height="52" FontSize="18" Background="#171717" Foreground="#FFFFFF" BorderBrush="#3C4043" Padding="12" Margin="0,0,0,12"/>
                <TextBlock Text="Variable (single letter)" Foreground="#9AA0A6" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="IntegralVariableTextBox" Height="52" FontSize="18" Background="#171717" Foreground="#FFFFFF" BorderBrush="#3C4043" Padding="12" MaxLength="1" Width="140" Margin="0,0,0,12"/>

                <TextBlock Text="Bounds" Foreground="#9AA0A6" FontSize="12" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBox x:Name="IntegralLowerBoundTextBox" Height="52" FontSize="18" Background="#171717" Foreground="#FFFFFF" BorderBrush="#3C4043" Padding="12" Width="140" Margin="0,0,12,0"/>
                    <TextBox x:Name="IntegralUpperBoundTextBox" Height="52" FontSize="18" Background="#171717" Foreground="#FFFFFF" BorderBrush="#3C4043" Padding="12" Width="140"/>
                </StackPanel>

                <TextBlock Text="Integrating method" Foreground="#9AA0A6" FontSize="12" Margin="0,0,0,4"/>
                <ComboBox x:Name="IntegralMethodComboBox" Style="{StaticResource CalculatorComboBox}" Margin="0,0,0,14" SelectedValuePath="Tag">
                    <ComboBoxItem Content="Let calculator decide" Tag="0" Style="{StaticResource CalculatorComboBoxItem}" IsSelected="True"/>
                    <ComboBoxItem Content="Gaussian Quadrature" Tag="1" Style="{StaticResource CalculatorComboBoxItem}"/>
                    <ComboBoxItem Content="Double Tanh-Sinh Quadrature" Tag="2" Style="{StaticResource CalculatorComboBoxItem}"/>
                    <ComboBoxItem Content="Adaptive Quadrature" Tag="3" Style="{StaticResource CalculatorComboBoxItem}"/>
                    <ComboBoxItem Content="Simpson's Rule" Tag="4" Style="{StaticResource CalculatorComboBoxItem}"/>
                </ComboBox>

                <Button Content="Integrate" Style="{StaticResource EqualsButton}" Width="140" HorizontalAlignment="Left" Click="ApplyIntegral_Click"/>
                <TextBlock Text="NOTE👉🏻The integration process may take a long time" Foreground="#9AA0A6" FontSize="12" Margin="0,0,0,4"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
